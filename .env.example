# Copy this file to .env and fill in values before running docker compose
# Or run: ./scripts/setup.sh to generate automatically.
#
# Required
SERVICE_TOKEN=
SECRET_KEY=
POSTGRES_PASSWORD=
DIT_DB_PASSWORD=
#
# Optional
# CORE_IMAGE=ghcr.io/liuxsh9/dit-core:latest
# GATEWAY_IMAGE=ghcr.io/liuxsh9/dit-gateway:latest
# GATEWAY_PORT=3000
# DISABLE_REGISTRATION=true
# ROOT_URL=http://localhost:3000/
#
# Git SSH (default: bound to localhost only, SSH disabled in Forgejo)
# To enable SSH on a public port, set both:
# DISABLE_SSH=false
# SSH_EXPOSE=0.0.0.0:3001    (or any available port, e.g. 2222)
# SSH_PORT=3001              (tells Forgejo what port to show in clone URLs)
# DISABLE_SSH=false
# SSH_EXPOSE=0.0.0.0:3001
# SSH_PORT=3001
#
# TLS (required with: docker compose --profile tls up -d)
# DOMAIN=data.example.com
