# DIT Gateway systemd unit file.
# Edit WorkingDirectory to match your installation path.
# Install: cp contrib/systemd/dit-gateway.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable dit-gateway
[Unit]
Description=DIT Gateway (Docker Compose)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/dit-gateway
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
